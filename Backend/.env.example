; Konfigurasi database MySQL
SKILLUP_DB_HOST=127.0.0.1
SKILLUP_DB_PORT=3306
SKILLUP_DB_NAME=skillup
SKILLUP_DB_USER=root
SKILLUP_DB_PASS=

; Debug hanya untuk lingkungan lokal
SKILLUP_DEBUG=0

; SMTP untuk OTP Lupa Password - isi dengan kredensial App Password, jangan commit
